# --- Databases ---
# External tasks DB (read + update on `tasks` only). Prod values supplied separately.
EXTERNAL_TASKS_DSN=postgresql+asyncpg://agent:agent@localhost:5440/agent_clicker
# Internal owned DB for settings + task_runtime.
INTERNAL_STATE_DSN=postgresql+asyncpg://agent:agent@localhost:5440/agent_clicker

# --- LLM ---
LLM_API_KEY=sk-changeme
LLM_BASE_URL=https://api.deepseek.com/v1
BOOT_LLM_MODEL=deepseek-chat

# --- Proxy (optional in dev — empty = direct connection) ---
PROXY_PROVIDER_URL=
PROXY_PROVIDER_TOKEN=
PROXY_LIST=

# --- Worker defaults (boot — copied to settings table on first start) ---
BOOT_WORKER_CONCURRENCY=2
BOOT_LEASE_TIMEOUT_SECONDS=600
BOOT_MAX_ATTEMPTS=3
BOOT_BACKOFF_BASE_SECONDS=30
BOOT_MIN_TIME_ON_SITE_SECONDS=30
BOOT_MAX_TIME_ON_SITE_SECONDS=180

# --- Agent defaults ---
BOOT_AGENT_MAX_STEPS=50
BOOT_AGENT_USE_VISION=true
BOOT_AGENT_USE_THINKING=true
BOOT_AGENT_MAX_FAILURES=5
BOOT_AGENT_STEP_TIMEOUT=180
BOOT_AGENT_MAX_ACTIONS_PER_STEP=10
BOOT_AGENT_ENABLE_PLANNING=true
BOOT_AGENT_EXTEND_SYSTEM_MESSAGE=

# --- Browser defaults ---
BOOT_BROWSER_HEADLESS=true
BOOT_BROWSER_DISABLE_SECURITY=false
BOOT_BROWSER_WAIT_BETWEEN_ACTIONS=0.5
BOOT_BROWSER_MINIMUM_WAIT_PAGE_LOAD_TIME=0.5
BOOT_BROWSER_WAIT_FOR_NETWORK_IDLE_PAGE_LOAD_TIME=1.0
BOOT_BROWSER_HIGHLIGHT_ELEMENTS=false
BOOT_BROWSER_ENABLE_DEFAULT_EXTENSIONS=true
BOOT_BROWSER_CROSS_ORIGIN_IFRAMES=false
BOOT_BROWSER_MAX_IFRAMES=10

# --- Infra ---
ARTIFACTS_DIR=./artifacts
LOG_LEVEL=INFO
LOG_BUFFER_SIZE=2000

# --- Admin Panel ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8088
ADMIN_ALLOW_PUBLIC=false
# Dev-only: allow POST/DELETE /api/tasks to insert/delete in tasks DB.
# MUST be false in production (external tasks DB grants no INSERT/DELETE).
ENABLE_TASK_MUTATIONS=true
